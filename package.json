{
  "name": "ammunation",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.5",
    "@cap-js/hana": "^2.3.3",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": ">=8",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "h": "cds watch --profile hybrid",
    "d": "cf deploy mta_archives/ammunation_1.0.0.mtar",
    "watch-ammunitionui": "cds watch --open ammunitionui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy ammunation --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "server": {
      "index": true
    },
    "requires": {
      "db": "hana",
      "auth": "dummy"
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/ammunitionui"
  ]
}
